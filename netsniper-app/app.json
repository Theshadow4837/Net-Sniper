{
  "expo": {
    "name": "Net Sniper",
    "slug": "net-sniper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A121C"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.netsniper.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Net Sniper uses the camera to show live video of the net while you track your shots."
      }
    },
    "android": {
      "package": "com.netsniper.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A121C"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Net Sniper needs camera access to show the net and track shots.",
          "enableMicrophonePermission": false
        }
      ]
    ]
  }
}
